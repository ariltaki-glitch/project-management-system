<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="800" viewBox="0 0 1200 800">
  <rect width="1200" height="800" fill="#f3f4f6"/>
  <text x="600" y="400" text-anchor="middle" font-family="Arial" font-size="24" fill="#6b7280">Gantt Chart Screenshot</text>
  <text x="600" y="430" text-anchor="middle" font-family="Arial" font-size="16" fill="#9ca3af">(Ganti dengan screenshot asli)</text>
  <rect x="100" y="100" width="1000" height="600" fill="white" stroke="#e5e7eb" rx="8"/>
  <rect x="100" y="100" width="1000" height="40" fill="#1f2937"/>
  <text x="120" y="125" font-family="Arial" font-size="16" fill="white">Gantt Chart - Proyek</text>
  <rect x="100" y="160" width="1000" height="400" fill="#f9fafb" stroke="#e5e7eb"/>
  <rect x="110" y="170" width="200" height="30" fill="#e5e7eb"/>
  <text x="210" y="190" text-anchor="middle" font-family="Arial" font-size="12" fill="#374151">Tugas</text>
  <rect x="320" y="170" width="750" height="30" fill="#e5e7eb"/>
  <text x="700" y="190" text-anchor="middle" font-family="Arial" font-size="12" fill="#374151">Timeline (Nov 2026)</text>
  <rect x="110" y="220" width="200" height="40" fill="white" stroke="#d1d5db"/>
  <text x="210" y="245" text-anchor="middle" font-family="Arial" font-size="11" fill="#374151">Pengumpulan Data</text>
  <rect x="320" y="225" width="100" height="30" fill="#10b981" rx="4"/>
  <text x="370" y="245" text-anchor="middle" font-family="Arial" font-size="10" fill="white">4 hari</text>
  <rect x="110" y="270" width="200" height="40" fill="white" stroke="#d1d5db"/>
  <text x="210" y="295" text-anchor="middle" font-family="Arial" font-size="11" fill="#374151">Analisis Alur Dokumen</text>
  <rect x="420" y="275" width="120" height="30" fill="#10b981" rx="4"/>
  <text x="480" y="295" text-anchor="middle" font-family="Arial" font-size="10" fill="white">5 hari</text>
  <rect x="110" y="320" width="200" height="40" fill="white" stroke="#d1d5db"/>
  <text x="210" y="345" text-anchor="middle" font-family="Arial" font-size="11" fill="#374151">Perancangan DB</text>
  <rect x="540" y="325" width="140" height="30" fill="#3b82f6" rx="4"/>
  <rect x="540" y="325" width="84" height="30" fill="#60a5fa" rx="4"/>
  <text x="610" y="345" text-anchor="middle" font-family="Arial" font-size="10" fill="white">6 hari (60%)</text>
  <rect x="110" y="370" width="200" height="40" fill="white" stroke="#d1d5db"/>
  <text x="210" y="395" text-anchor="middle" font-family="Arial" font-size="11" fill="#374151">Pengembangan Modul</text>
  <rect x="680" y="375" width="200" height="30" fill="#3b82f6" rx="4"/>
  <rect x="680" y="375" width="50" height="30" fill="#60a5fa" rx="4"/>
  <text x="780" y="395" text-anchor="middle" font-family="Arial" font-size="10" fill="white">10 hari (25%)</text>
  <rect x="110" y="420" width="200" height="40" fill="white" stroke="#d1d5db"/>
  <text x="210" y="445" text-anchor="middle" font-family="Arial" font-size="11" fill="#374151">Pengujian Fungsional</text>
  <rect x="880" y="425" width="100" height="30" fill="#9ca3af" rx="4"/>
  <text x="930" y="445" text-anchor="middle" font-family="Arial" font-size="10" fill="white">5 hari</text>
  <rect x="110" y="470" width="200" height="40" fill="white" stroke="#d1d5db"/>
  <text x="210" y="495" text-anchor="middle" font-family="Arial" font-size="11" fill="#374151">Deployment</text>
  <rect x="980" y="475" width="60" height="30" fill="#9ca3af" rx="4"/>
  <text x="1010" y="495" text-anchor="middle" font-family="Arial" font-size="10" fill="white">3 hari</text>
  <line x1="320" y1="210" x2="320" y2="520" stroke="#e5e7eb" stroke-width="1" stroke-dasharray="5,5"/>
  <line x1="420" y1="210" x2="420" y2="520" stroke="#e5e7eb" stroke-width="1" stroke-dasharray="5,5"/>
  <line x1="540" y1="210" x2="540" y2="520" stroke="#e5e7eb" stroke-width="1" stroke-dasharray="5,5"/>
  <line x1="680" y1="210" x2="680" y2="520" stroke="#e5e7eb" stroke-width="1" stroke-dasharray="5,5"/>
  <line x1="880" y1="210" x2="880" y2="520" stroke="#e5e7eb" stroke-width="1" stroke-dasharray="5,5"/>
  <line x1="980" y1="210" x2="980" y2="520" stroke="#e5e7eb" stroke-width="1" stroke-dasharray="5,5"/>
  <rect x="320" y="540" width="20" height="20" fill="#10b981"/>
  <text x="345" y="555" font-family="Arial" font-size="10" fill="#374151">Selesai</text>
  <rect x="370" y="540" width="20" height="20" fill="#3b82f6"/>
  <text x="395" y="555" font-family="Arial" font-size="10" fill="#374151">Proses</text>
  <rect x="420" y="540" width="20" height="20" fill="#9ca3af"/>
  <text x="445" y="555" font-family="Arial" font-size="10" fill="#374151">Pending</text>
</svg>
